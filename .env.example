# .env.example -- copy to .env at the repo root and fill in. NEVER commit .env.
#
# Consumed by foundry-mcp/scripts/Import-ArchiveSearchToSql.ps1 (the archive
# index loader). Explicit script parameters override these values; these are the
# fallback so routine runs need no arguments.

# ── Shared MCP SQL host ───────────────────────────────────────────────────────
# One Azure SQL logical server, one database per MCP. Provision/verify it with
#   foundry-mcp/scripts/Initialize-McpSqlHost.ps1 -ServerName <name>
# which prints the exact values to paste here when it finishes green.
#
# Azure SQL (target state -- always-on, multi-user, Entra auth):
#   ARCHIVE_SQL_SERVER=sql-gipartners-mcp.database.windows.net
#   ARCHIVE_SQL_DATABASE=ArchiveIndex
#   ...and run the loader with -SqlAuth Entra (add -SqlUser <upn> if the
#      machine is not Entra-joined and you want an interactive prompt).
#
# Workstation LocalDB (development only -- the instance stops when idle and
# per-user instances are not reachable by anyone else):
ARCHIVE_SQL_SERVER=(localdb)\MSSQLLocalDB
ARCHIVE_SQL_DATABASE=ArchiveIndex
